# R session / workspace junk — never commit these
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Build artifacts
*.tar.gz
*.Rcheck/

# Local run outputs (can contain results from real DataLab data — never commit)
outputs/*
!outputs/.gitkeep

# Real ABS reference data you download yourself (DZN-SA2 concordance, SA2
# shapefiles, real Census extracts) — large/licensed, never commit
dev/reference_data/*
!dev/reference_data/.gitkeep

